# Copy this file to ".env" and edit. Lines starting with # are comments.
# Windows: path of tesseract.exe (leave empty if "tesseract" works in a terminal)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# English + French documents (install eng.traineddata and fra.traineddata). Add +ara for Arabic.
OCR_LANG=eng+fra
OCR_PSM=6
MIN_CONFIDENCE=0.5

# Handwriting (cheque amount / payee, filled-in contract lines, notes on an invoice): TrOCR "handwritten" next to Tesseract.
# auto = use it when torch + transformers are installed (first use downloads ~1.3 GB, then cached) | on = error if it cannot load | off
DOCUMIND_HANDWRITING=auto
# microsoft/trocr-base-handwritten (best) | microsoft/trocr-small-handwritten (3x faster) | a folder you fine-tuned
HANDWRITING_MODEL=microsoft/trocr-base-handwritten
